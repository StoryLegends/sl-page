# ==========================================
# STORYLEGENDS UNIFIED SYSTEM CONFIGURATION
# ALL ENVIRONMENT VARIABLES ARE IN THIS FILE
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL / MySQL)
DATABASE_URL=postgres://user:password@host:5432/dbname
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname?sslmode=require
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# 2. MINIO S3 OBJECT STORAGE
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=storylegends-assets
MINIO_USE_SSL=false

# 3. MINECRAFT SERVER DOCKER & RCON CONFIGURATION
MINECRAFT_CONTAINER_NAME=sl-minecraft-server
MINECRAFT_SERVER_PORT=25565
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=storylegends_rcon_pass
MINECRAFT_SERVER_PATH=./docker/minecraft_data
MINECRAFT_MEMORY=4G
MINECRAFT_EULA=TRUE
MINECRAFT_TYPE=PAPER
MINECRAFT_VERSION=1.20.4

# 4. FRONTEND & BACKEND PORTS
VITE_API_URL=http://localhost:8080
PORT=5173
BACKEND_PORT=8080
