# ==========================================
# CENTRALIZED DOCKER ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=slbackend
POSTGRES_USER=sluser
POSTGRES_PASSWORD=change_this_postgres_password

# MinIO Storage Configuration (VPS Image Storage)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_BUCKET_NAME=storylegends-uploads
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://your-vps-ip:9000/storylegends-uploads

# Security & JWT Token Key
JWT_SECRET=change_this_very_long_super_secret_jwt_key_32bytes_min

# Google reCAPTCHA v2 / v3
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Discord Bot & OAuth2 Integration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://your-vps-ip/api/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_SERVER_ID=your_discord_server_id

# Email Service (Mailgun API)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.storylegends.xyz
MAILGUN_FROM_EMAIL=noreply@storylegends.xyz

# Stripe & Sponsorship Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Frontend App Environment
VITE_API_URL=/api
VITE_DISCORD_SERVER_URL=https://discord.gg/storylegends
